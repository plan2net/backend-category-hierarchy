{
  "name": "plan2net/backend-category-hierarchy",
  "version": "14.0.0",
  "type": "typo3-cms-extension",
  "description": "Show category hierarchy information in list view",
  "homepage": "https://plan2.net",
  "license": [
    "GPL-2.0-or-later"
  ],
  "keywords": [
    "TYPO3 CMS",
    "Category",
    "Backend"
  ],
  "require": {
    "php": "^8.2",
    "typo3/cms-core": "^13.4 || ^14.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.64",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^11.5",
    "typo3/testing-framework": "^9.3 || ^10.0",
    "vimeo/psalm": "^6.0"
  },
  "suggest": {
    "georgringer/news": "*"
  },
  "autoload": {
    "psr-4": {
      "Plan2net\\BackendCategoryHierarchy\\": "Classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Plan2net\\BackendCategoryHierarchy\\Tests\\": "Tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true,
      "typo3/class-alias-loader": true,
      "typo3/cms-composer-installers": true
    },
    "sort-packages": true
  },
  "scripts": {
    "cs": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix",
    "phpstan": "phpstan analyse",
    "psalm": "psalm --no-cache",
    "test:unit": "phpunit -c Tests/phpunit.xml --testsuite unit --testdox",
    "quality": [
      "@cs",
      "@phpstan",
      "@psalm",
      "@test:unit"
    ]
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "backend_category_hierarchy"
    }
  }
}
